{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://embernova/contracts/analysis_result.schema.json",
  "title": "AnalysisResult (written by Analysis Lab code to /mnt/data/result.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "question", "method", "inputs", "results", "tables", "charts", "warnings"],
  "properties": {
    "schema_version": {"const": "1"},
    "question": {"type": "string", "maxLength": 1000},
    "method": {"type": "string", "maxLength": 600},
    "inputs": {"type": "array", "maxItems": 10, "items": {"type": "object", "additionalProperties": false,
      "required": ["file", "filters", "n_rows"],
      "properties": {"file": {"type": "string"}, "filters": {"type": "string"}, "n_rows": {"type": "integer", "minimum": 0}}}},
    "results": {"type": "array", "maxItems": 50, "items": {"type": "object", "additionalProperties": false,
      "required": ["name", "value", "unit", "uncertainty", "uncertainty_kind", "n", "note"],
      "properties": {"name": {"type": "string"}, "value": {"type": "number"}, "unit": {"type": "string", "description": "pint-parsable; '1' for dimensionless"},
        "uncertainty": {"type": ["number", "null"]}, "uncertainty_kind": {"enum": ["1-sigma", "95%CI", "IQR", "none"]},
        "n": {"type": ["integer", "null"]}, "note": {"type": "string"}}}},
    "tables": {"type": "array", "maxItems": 5, "items": {"type": "object", "additionalProperties": false,
      "required": ["name", "file", "columns"],
      "properties": {"name": {"type": "string"}, "file": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+\\.csv$"},
        "columns": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "unit"],
          "properties": {"name": {"type": "string"}, "unit": {"type": ["string", "null"]}}}}}}},
    "charts": {"type": "array", "maxItems": 4, "items": {"type": "object", "additionalProperties": false,
      "required": ["title", "chart_type", "data_file", "x", "y", "series_field"],
      "properties": {"title": {"type": "string"}, "chart_type": {"enum": ["scatter", "line", "bar", "box"]},
        "data_file": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+\\.csv$"},
        "x": {"type": "object", "additionalProperties": false, "required": ["field", "unit"], "properties": {"field": {"type": "string"}, "unit": {"type": ["string", "null"]}}},
        "y": {"type": "object", "additionalProperties": false, "required": ["field", "unit"], "properties": {"field": {"type": "string"}, "unit": {"type": ["string", "null"]}}},
        "series_field": {"type": ["string", "null"]}}}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
