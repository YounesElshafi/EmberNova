{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://embernova/contracts/sse_events.schema.json",
  "title": "SSE event data payloads (event name in the SSE 'event:' field must equal 'event' below)",
  "type": "object",
  "required": ["event", "seq", "turn_id", "t_ms"],
  "properties": {
    "event": {"enum": ["turn.started", "status", "tool.started", "tool.completed", "evidence.added", "artifact.created",
                       "text.delta", "text.completed", "turn.completed", "error"]},
    "seq": {"type": "integer", "minimum": 0},
    "turn_id": {"type": "string"},
    "t_ms": {"type": "integer", "minimum": 0, "description": "ms since turn start"}
  },
  "allOf": [
    {"if": {"properties": {"event": {"const": "turn.started"}}}, "then": {"required": ["session_id", "model", "replay"],
      "properties": {"session_id": {"type": "string"}, "model": {"type": ["string", "null"]}, "replay": {"type": "boolean"}}}},
    {"if": {"properties": {"event": {"const": "status"}}}, "then": {"required": ["phase", "message"],
      "properties": {"phase": {"enum": ["thinking", "searching", "querying", "analyzing", "writing"]}, "message": {"type": "string"}}}},
    {"if": {"properties": {"event": {"const": "tool.started"}}}, "then": {"required": ["call_id", "tool", "label", "args_summary"],
      "properties": {"call_id": {"type": "string"}, "tool": {"type": "string"}, "label": {"type": "string"}, "args_summary": {"type": "string"}}}},
    {"if": {"properties": {"event": {"const": "tool.completed"}}}, "then": {"required": ["call_id", "tool", "status", "latency_ms", "summary", "evidence_ids", "artifact_ids"],
      "properties": {"call_id": {"type": "string"}, "tool": {"type": "string"}, "status": {"enum": ["ok", "error"]},
        "latency_ms": {"type": "integer"}, "summary": {"type": "string"},
        "evidence_ids": {"type": "array", "items": {"type": "string"}}, "artifact_ids": {"type": "array", "items": {"type": "string"}},
        "error_code": {"type": ["string", "null"]}}}},
    {"if": {"properties": {"event": {"const": "evidence.added"}}}, "then": {"required": ["evidence"],
      "properties": {"evidence": {"$ref": "evidence.schema.json"}}}},
    {"if": {"properties": {"event": {"const": "artifact.created"}}}, "then": {"required": ["artifact"],
      "properties": {"artifact": {"$ref": "artifact.schema.json"}, "fetch_url": {"type": ["string", "null"]}}}},
    {"if": {"properties": {"event": {"const": "text.delta"}}}, "then": {"required": ["delta"], "properties": {"delta": {"type": "string"}}}},
    {"if": {"properties": {"event": {"const": "text.completed"}}}, "then": {"required": ["answer"],
      "properties": {"answer": {"type": "object", "additionalProperties": false,
        "required": ["validated_markdown", "citations", "sections_present", "audit", "evidence_strength", "followups", "si_generated"],
        "properties": {
          "validated_markdown": {"type": "string", "description": "markers replaced by [n]"},
          "citations": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["n", "evidence_id"],
            "properties": {"n": {"type": "integer", "minimum": 1}, "evidence_id": {"type": "string"}}}},
          "sections_present": {"type": "array", "items": {"enum": ["answer", "evidence", "implications", "limits", "hypotheses"]}},
          "audit": {"type": "object", "additionalProperties": false,
            "required": ["invalid_citations", "kind_mismatches", "uncited_sentences", "ungrounded_numbers"],
            "properties": {"invalid_citations": {"type": "integer"}, "kind_mismatches": {"type": "integer"},
              "uncited_sentences": {"type": "integer"}, "ungrounded_numbers": {"type": ["integer", "null"]},
              "details": {"type": "array", "items": {"type": "string"}}}},
          "evidence_strength": {"type": "object", "additionalProperties": {"enum": ["strong", "moderate", "limited"]}},
          "followups": {"type": "array", "maxItems": 3, "items": {"type": "string"}},
          "si_generated": {"const": true}
        }}}}},
    {"if": {"properties": {"event": {"const": "turn.completed"}}}, "then": {"required": ["usage", "cost_usd", "latency_ms"],
      "properties": {"usage": {"type": "object", "required": ["input_tokens", "cached_tokens", "output_tokens"],
        "properties": {"input_tokens": {"type": "integer"}, "cached_tokens": {"type": "integer"}, "output_tokens": {"type": "integer"}}},
        "cost_usd": {"type": "number"}, "latency_ms": {"type": "integer"}}}},
    {"if": {"properties": {"event": {"const": "error"}}}, "then": {"required": ["code", "message", "retryable"],
      "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "retryable": {"type": "boolean"}}}}
  ]
}
