# SI-assisted application configuration. Never put this key in frontend code.
OPENAI_API_KEY=
AGENT_MODEL=gpt-6.1-sol
AGENT_FALLBACK_MODEL=gpt-6.1-terra
AGENT_REASONING_EFFORT_CHAT=medium
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=512
EMBEDDING_PRICE_PER_MILLION=0.02
RETRIEVAL_TEXT_WEIGHT=0.7
RETRIEVAL_FACET_WEIGHT=0.3
RETRIEVAL_AVAILABILITY_WEIGHT=0.0
# Curated scientific-facet agreement (curation/investigation_facets.yaml); tuned on benchmark dev split.
RETRIEVAL_SCIENCE_WEIGHT=0.5
MAX_TOOL_ROUNDS=6
MAX_OUTPUT_TOKENS=3500
MAX_TURN_INPUT_TOKENS=150000
TURN_TIMEOUT_S=120
DAILY_BUDGET_USD=2
MAX_TURN_COST_USD=0.30
PER_IP_TURNS_PER_HOUR=20
PRICE_INPUT_PER_MILLION=2
PRICE_CACHED_PER_MILLION=0.10
PRICE_OUTPUT_PER_MILLION=10
ANALYSIS_LAB=false
ILLUSTRATIONS=false
ADMIN_TOKEN=

# Set true when serving over HTTPS in production.
SECURE_COOKIES=false
TRUSTED_PROXY=false
BUILD_DIR=build
DATA_DIR=data
STATE_DIR=build/state
