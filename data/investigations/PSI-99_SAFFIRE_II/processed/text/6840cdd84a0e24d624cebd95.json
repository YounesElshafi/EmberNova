    {
      "paragraph_number": 60,
      "text": "BIT",
      "style": null,
      "figure_table_references": []
    },
    {
      "paragraph_number": 61,
      "text": "Built-In Test images were captured immediately after the payload was powered on",
      "style": null,
      "figure_table_references": []
    },
    {
      "paragraph_number": 62,
      "text": "DistortionGrids_Sample_ROI",
      "style": null,
      "figure_table_references": []
    },
    {
      "paragraph_number": 63,
      "text": "Image sets characterize the camera distortion of the system (pre-flight) using a checkerboard pattern grid",
      "style": null,
      "figure_table_references": []
    },
    {
      "paragraph_number": 64,
      "text": "DistortionGrids_Sample_ROI_Mapped",
      "style": null,
      "figure_table_references": []
    },
    {
      "paragraph_number": 65,
      "text": "DistortionGrid images processed post-flight where the distortion of the camera system is corrected, or mapped, to a flat grid",
      "style": null,
      "figure_table_references": []
    },
    {
      "paragraph_number": 66,
      "text": "jpeg",
      "style": null,
      "figure_table_references": []
    },
    {
      "paragraph_number": 67,
      "text": "Jpeg images created on-board SAFFIRE payload and downlinked by command",
      "style": null,
      "figure_table_references": []
    },
    {
      "paragraph_number": 68,
      "text": "Jpeg_Mapped",
      "style": null,
      "figure_table_references": []
    },
    {
      "paragraph_number": 69,
      "text": "Jpeg images processed post-flight where the distortion of the camera system is corrected, or mapped, to a flat grid",
      "style": null,
      "figure_table_references": []
    },
    {
      "paragraph_number": 70,
      "text": "jpeg2png_icmad",
      "style": null,
      "figure_table_references": []
    },
    {
      "paragraph_number": 71,
      "text": "Jpeg images annotated with ICMAD 'Exposure' and 'Gain' information.  Data is appended to the bottom of each frame using ImageMagick script and re-saved as .png format to minimize additional compression artifacts",
      "style": null,
      "figure_table_references": []
    },
    {
      "paragraph_number": 72,
      "text": "Raw_DistroMaster",
      "style": null,
      "figure_table_references": []
    },
    {
      "paragraph_number": 73,
      "text": "Camera original RAW files recorded on-board and downlinked on command.  Contains 8-byte offset that must be processed prior to color interpolation and distribution",
      "style": null,
      "figure_table_references": []
    },
    {
      "paragraph_number": 74,
      "text": "Raw2TIFF",
      "style": null,
      "figure_table_references": []
    },
    {
      "paragraph_number": 75,
      "text": "TIFF images of the RAW Distribution Master files, color interpolated (demosaiced) using IrfanView Batch Conversion process",
      "style": null,
      "figure_table_references": []
    },
    {
      "paragraph_number": 76,
      "text": "Raw2TIFF_Mapped",
      "style": null,
      "figure_table_references": []
    },
    {
      "paragraph_number": 77,
      "text": "RAW2TIFF images processed post-flight where the distortion of the camera system is corrected, or mapped, to a flat grid",
      "style": null,
      "figure_table_references": []
    },
    {
      "paragraph_number": 78,
      "text": "Raw2TIFF_icmad",
      "style": null,
      "figure_table_references": []
    },
    {
      "paragraph_number": 79,
      "text": "Raw2TIFF files annotated with ICMAD 'Exposure' and 'Gain' information. Data is appended to the bottom of each frame using ImageMagick script and resaved as TIFF",
      "style": null,
      "figure_table_references": []
    },
    {
      "paragraph_number": 80,
      "text": "Raw2TIFF_icmad_Mapped",
      "style": null,
      "figure_table_references": []
    },
    {
      "paragraph_number": 81,
      "text": "RAW2TIFF_icmad images processed post-flight where the distortion of the camera system is corrected, or mapped, to a flat grid",
      "style": null,
      "figure_table_references": []
    },
    {
      "paragraph_number": 83,
      "text": "Some image sets are very large. They may contain over 10,000 images which makes it impractical to display as thumbnails in the Image Gallery which appears on the “Image Data and Information” tab of the Videos & Images record of the image set. In the case of very large image sets, all the images are provided in zip files labeled “Original Image Files” on the “Image Data and Information” tab. These files can be downloaded and viewed on the local machine.",
      "style": null,
      "figure_table_references": []
    }
